pipeline {
    agent any

    tools {
        nodejs 'node' // Ensures Node.js is configured in your Jenkins Global Tool Configuration
    }

    stages {
        stage('Clone Repository') {
            steps {
                echo 'Checkout code...'
                // Jenkins automatically handles checkout in a declarative pipeline
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing application dependencies...'
                dir('hello-world-app') {
                    // This executes an actual npm install instead of just checking versions
                    sh 'npm install'
                }
            }
        }

        stage('Build & Test Application') {
            steps {
                echo 'Building and testing the application...'
                dir('hello-world-app') {
                    // Executes the test script defined in package.json
                    sh 'npm test'
                    // Validates that the application runs successfully
                    sh 'node app.js'
                }
            }
        }
    }
    
    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check logs for errors.'
        }
    }
}